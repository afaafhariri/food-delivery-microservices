# Copy to secrets.env (git-ignored) and set a strong password before the first
# deploy. Postgres only reads it when its data volume is first initialised;
# changing it later also needs ALTER USER inside the database.
username=quickbite
password=change-me
# Keycloak admin console (master realm, user "admin"); also read only on first start.
keycloak_admin_password=change-me-too
